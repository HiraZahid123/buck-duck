# Application Port (Hostinger sets this automatically in production)
PORT=3000

# Cloud PostgreSQL Database URL (Supabase, Neon, Aiven, or Hostinger VPS)
# Supabase example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Neon example: postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/buckduck?sslmode=require"

# JWT Secret for Auth Module
JWT_SECRET=buckduck_jwt_super_secret_key_change_in_production_2026

# Show the one-click "View as Shopper / Merchant / Driver / Admin" demo bar
DEMO_MODE=true

# Stripe (Optional for simulated checkout)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
